# based on artist's Xlibre PKGBUILD for Artix; adapted for XPrism.
#
# The packages are named xprism-xserver*. They provide and conflict with
# both xorg-server* and xlibre-xserver*, so drivers built for either
# (e.g. xlibre-input-libinput) keep working and pacman swaps them out.

pkgbase="xprism-xserver"
pkgname=("${pkgbase}"{,-bootstrap,-common,-devel,-xephyr,-xvfb})
pkgver=26.11.01 # set by pkgver() from meson.build
pkgrel=1
arch=('aarch64' 'x86_64')
url="https://github.com/XPrismOrg/xserver"
license=('LicenseRef-Adobe-Display-PostScript' 'BSD-3-Clause' 'LicenseRef-DEC-3-Clause'
         'HPND' 'LicenseRef-HPND-sell-MIT-disclaimer-xserver' 'HPND-sell-variant'
         'ICU' 'ISC' 'MIT' 'MIT-open-group' 'NTP' 'SGI-B-2.0' 'SMLNJ' 'X11'
         'X11-distribute-modifications-variant')
makedepends=('libepoxy' 'libpciaccess' 'libunwind' 'libx11' 'libxaw' 'libxcvt'
             'libxfont2' 'libxi' 'libxkbfile' 'libxmu' 'libxrender' 'libxres'
             'libxshmfence>=1.1' 'libxtst' 'libxv' 'mesa' 'mesa-libgl'
             'meson>=0.58' 'pixman>=0.27.2' 'systemd>=209' 'xcb-util'
             'xcb-util-image' 'xcb-util-keysyms' 'xcb-util-renderutil'
             'xcb-util-wm' 'xorg-font-util' 'xorg-util-macros' 'xorg-xkbcomp'
             'xorgproto>=7.0.31' 'xtrans>=1.3.5')
groups=('xprism')
options=('!emptydirs')

#
# hacks for building with PKGBUILD under the source tree (CI specific)
#
export _sourcedir=/github/workspace
export _builddir="${_sourcedir}/build"    # temporary build directory for meson
export _pkgsrc="$(pwd)"                   # directory of PKGBUILD file

pkgver() {
  # the version in meson.build (YY.MM.NN or YY.MM.NN.PP); a "-rc1" style
  # suffix becomes "rc1", since pkgver may not contain "-"
  sed -n "s/^ *version: '\\([^']*\\)',/\\1/p" "${_sourcedir}/meson.build" | head -1 | tr -d '-'
}

build() {
  # Since pacman 5.0.2-2, hardened flags are now enabled in makepkg.conf
  # With them, modules fail to load with undefined symbol.
  # See https://bugs.archlinux.org/task/55102 / https://bugs.archlinux.org/task/54845
  export CFLAGS="${CFLAGS/-fno-plt}"
  export CXXFLAGS="${CXXFLAGS/-fno-plt}"
  export LDFLAGS="${LDFLAGS/-Wl,-z,now}"

  local meson_options=(
    "${_sourcedir}"
    "${_builddir}"
    -D ipv6=true
    -D xvfb=true
    -D xorg=true
    -D xephyr=true
    -D glamor=true
    -D udev=true
    -D dtrace=false
    -D systemd_logind=true
    -D suid_wrapper=true
    -D xkb_dir='/usr/share/X11/xkb'
    -D xkb_output_dir='/var/lib/xkb'
    -D libunwind=true
  )

  cd "${_sourcedir}"
  arch-meson "${meson_options[@]}"
  meson compile -C "${_builddir}"
}

package_xprism-xserver() {
  pkgdesc="XPrism X server: X11 with per-application permissions (based on XLibre)"
  depends=('dbus' 'glibc' 'libdrm' 'libepoxy' 'libgl' 'libpciaccess' 'libtirpc'
           'libunwind' 'libxau' 'libxcvt' 'libxdmcp' 'libxfont2' 'libbsd'
           'libxshmfence>=1.1' 'nettle' 'pixman>=0.27.2' 'sh' 'libbsd'
           'systemd-libs>=209' 'xlibre-input-libinput'
           "${pkgbase}-common=${pkgver}-${pkgrel}") # FS#52949
  # see include/xf86Module.h for ABI versions - we provide major numbers that drivers can depend on
  # and /usr/lib/pkgconfig/{xprism,xlibre,xorg}-server.pc in xprism-xserver-devel pkg
  provides=('X-ABI-VIDEODRV_VERSION=28.0' 'X-ABI-XINPUT_VERSION=26.0' 'X-ABI-EXTENSION_VERSION=11.0' 'x-server' 'xorg-server' 'xlibre-server' 'xlibre-xserver')
  conflicts=('xorg-server' 'nvidia-utils<=331.20' 'glamor-egl' 'xf86-video-modesetting' 'xlibre-server' 'xlibre-xserver' 'xlibre-xserver-bootstrap')
  replaces=('xprism-xserver-bootstrap' 'glamor-egl' 'xf86-video-modesetting')
  options=('emptydirs')
  install="${pkgname}.install"

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  install -vdm755 "${pkgdir}/etc/X11/xorg.conf.d"

  # remove devel and common files
  rm -rf "${pkgdir}/usr/include" \
         "${pkgdir}/usr/lib/pkgconfig" \
         "${pkgdir}/usr/share/aclocal" \
         "${pkgdir}/usr/lib/xorg/protocol.txt" \
         "${pkgdir}/usr/share/man/man1/Xserver.1"

  # xephyr, xvfb
  find "${pkgdir}" -type f,l \( -name '*Xephyr*' -o -name '*Xvfb*' \) -delete
}

package_xprism-xserver-bootstrap() {
  pkgdesc="XPrism X server (bootstrap)"
  depends=('dbus' 'glibc' 'libdrm' 'libepoxy' 'libgl' 'libpciaccess' 'libtirpc'
           'libunwind' 'libxau' 'libxcvt' 'libxdmcp' 'libxfont2' 'libmd'
           'libxshmfence>=1.1' 'nettle' 'pixman>=0.27.2' 'sh'
           'systemd-libs>=209'
           "${pkgbase}-common=${pkgver}-${pkgrel}") # FS#52949
  # see include/xf86Module.h for ABI versions
  provides=("${pkgbase}" 'X-ABI-VIDEODRV_VERSION=28.0' 'X-ABI-XINPUT_VERSION=26.0' 'X-ABI-EXTENSION_VERSION=11.0' 'x-server' 'xorg-server' 'xlibre-xserver')
  conflicts=({xlibre,xorg}'-server' 'xlibre-xserver' 'xlibre-xserver-bootstrap' 'nvidia-utils<=331.20' 'glamor-egl' 'xf86-video-modesetting')
  # replaces=('glamor-egl' 'xf86-video-modesetting')
  options=('emptydirs')
  install="${pkgname}.install"

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  install -vdm755 "${pkgdir}/etc/X11/xorg.conf.d"

  # devel
  rm -rf \
    "${pkgdir}/usr/include" \
    "${pkgdir}/usr/lib/pkgconfig" \
    "${pkgdir}/usr/share/aclocal" \
    "${pkgdir}/usr/lib/xorg/protocol.txt" \
    "${pkgdir}/usr/share/man/man1/Xserver.1"

  # xephyr, xvfb
  find ${pkgdir} -type f,l \( -name '*Xephyr*' -o -name '*Xvfb*' \) -delete
}

package_xprism-xserver-common() {
  pkgdesc="XPrism X server common files"
  arch=('any')
  depends=('xkeyboard-config' 'xorg-setxkbmap' 'xorg-xkbcomp')
  provides=('xorg-server-common' 'xlibre-server-common' 'xlibre-xserver-common')
  conflicts=('xorg-server-common' 'xlibre-server-common' 'xlibre-xserver-common')

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  find "${pkgdir}" -type f,l ! \( -name 'protocol.txt' -o -name 'Xserver.1' \) -delete

  install -vDm644 "${_sourcedir}/COPYING" "${pkgdir}/usr/share/licenses/${pkgbase}/COPYING"
  install -vDm644 "${_sourcedir}/Xext/xkeyboard/README.compiled" "${pkgdir}/var/lib/xkb/README.compiled"
}

package_xprism-xserver-devel() {
  pkgdesc="Development files for the XPrism X server (driver SDK)"
  arch=('any')
  depends=('libpciaccess' 'mesa' 'pixman>=0.27.2' 'xorgproto>=7.0.31'
           'xorg-util-macros') # not technically required but almost every Xorg pkg needs it to build
  provides=('xorg-server-devel' 'xlibre-server-devel' 'xlibre-xserver-devel')
  conflicts=('xorg-server-devel' 'xlibre-server-devel' 'xlibre-xserver-devel')

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  find "${pkgdir}" -type f,l ! \( -name '*.h' -o -name '*.pc' -o -name '*.m4' \) -delete
}

package_xprism-xserver-xephyr() {
  pkgdesc="A nested XPrism server that runs as an X application"
  depends=('glibc' 'libepoxy' 'libgl' 'libtirpc' 'libunwind' 'libx11' 'libxau'
           'libxdmcp' 'libxfont2' 'libxshmfence' 'nettle' 'pixman>=0.27.2'
           'systemd-libs>=209' 'xcb-util' 'xcb-util-image' 'xcb-util-keysyms'
           'xcb-util-renderutil' 'xcb-util-wm'
           "${pkgbase}-common=${pkgver}-${pkgrel}")
  provides=('xorg-server-xephyr' 'xlibre-server-xephyr' 'xlibre-xserver-xephyr')
  conflicts=('xorg-server-xephyr' 'xlibre-server-xephyr' 'xlibre-xserver-xephyr')

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  find "${pkgdir}" -type f,l ! -name '*Xephyr*' -delete
}

package_xprism-xserver-xvfb() {
  pkgdesc="Virtual framebuffer XPrism server"
  license=('MIT' 'GPL-2.0-only')
  depends=('glibc' 'libgl' 'libtirpc' 'libunwind' 'libxau' 'libxdmcp'
           'libxfont2' 'nettle' 'pixman' 'sh' 'systemd-libs>=209'
           "${pkgbase}-common=${pkgver}-${pkgrel}" 'xorg-xauth')
  provides=('xorg-server-xvfb' 'xlibre-server-xvfb' 'xlibre-xserver-xvfb')
  conflicts=('xorg-server-xvfb' 'xlibre-server-xvfb' 'xlibre-xserver-xvfb')

  meson install -C "${_builddir}" --destdir "${pkgdir}"

  find "${pkgdir}" -type f,l ! -name '*Xvfb*' -delete

  install -vDm755 "${_pkgsrc}/xvfb-run"   "${pkgdir}/usr/bin/xvfb-run"
  install -vDm644 "${_pkgsrc}/xvfb-run.1" "${pkgdir}/usr/share/man/man1/xvfb-run.1"
}
